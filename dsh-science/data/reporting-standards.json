{
  "$meta": {
    "verifiedAt": "2026-10-20",
    "note": "投稿前门禁规则集。auto:true 的项可确定性检查；auto:false 的项需要 agent 读完技能后人工判断，工具只把它们列成待确认项。severity=blocking 表示审稿人几乎必然要求补，不是编辑会直接退稿的意思。",
    "sources": [
      "CONSORT 2010（RCT 报告）",
      "PRISMA 2020（系统综述）",
      "STROBE（观察性研究）",
      "ARRIVE 2.0（动物研究）",
      "TRIPOD（预测模型）",
      "TOP Guidelines（COS 透明度 8 项）",
      "Mensh & Kording, PLOS Comput Biol 2017（结构化写作）"
    ]
  },
  "profiles": {
    "general": {
      "label": "通用（任何投稿前都应过一遍）",
      "rules": [
        { "id": "GEN-01", "severity": "warning", "check": "forbid-pattern", "target": "title",
          "args": { "pattern": "^(A |An |The )?(Study|Investigation|Analysis|Evaluation|Exploration|Overview|Survey) (of|on|into)\\b", "flags": "i" },
          "message": "标题以「Study of / Investigation into」开头：这是话题，不是断言",
          "fix": "改成断言句：主语 + 动词 + 结论。审稿人从标题判断你是否提出了一个可证伪的主张。",
          "source": "Mensh & Kording 2017, rule 1", "auto": true },
        { "id": "GEN-02", "severity": "warning", "check": "forbid-pattern", "target": "title",
          "args": { "pattern": "\\b(novel|new|first|unprecedented)\\b", "flags": "i" },
          "message": "标题含 novel/new/first/unprecedented：这些词在标题里通常是未兑现的承诺",
          "fix": "删掉形容词，把「新在哪」写进摘要第二句的具体对比（对比谁、哪个量级、哪个机制）。",
          "source": "编辑初筛常见退回理由", "auto": true },
        { "id": "GEN-03", "severity": "warning", "check": "min-words", "target": "abstract",
          "args": { "min": 60, "max": 350 },
          "message": "摘要长度异常（<60 或 >350 词）",
          "fix": "摘要用 5 句：背景 / 空白 / 做法 / 关键结果（带数字）/ 意义。超长就删背景，不删结果。",
          "source": "Mensh & Kording 2017, rule 6", "auto": true },
        { "id": "GEN-04", "severity": "blocking", "check": "numbers-in-abstract", "target": "abstract",
          "args": { "min": 2 },
          "message": "摘要里几乎没有数字：读者无法判断效应大小",
          "fix": "至少给出主效应的数值（含单位）、样本量、以及一个不确定性（CI 或 p）。",
          "source": "摘要 5 句模板 + 统计报告规范", "auto": true },
        { "id": "GEN-05", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "\\bn\\s*=\\s*\\d+|\\bN\\s*=\\s*\\d+|\\d+\\s+(participants|patients|mice|samples|cells|subjects)", "flags": "i" },
          "message": "全文找不到样本量（n = / N = / 「X 名受试者」）",
          "fix": "在方法首句和每个图注里写明精确 n。审稿人第一件事就是数样本。",
          "source": "CONSORT/STROBE/ARRIVE 共同要求", "auto": true },
        { "id": "GEN-06", "severity": "warning", "check": "require-any", "target": "any",
          "args": { "patterns": ["\\b95%\\s*CI\\b", "\\bconfidence interval", "\\bIQR\\b", "±\\s*\\d", "\\bSE\\b", "\\bSD\\b"] },
          "message": "没有不确定性度量（CI / IQR / SD）",
          "fix": "报告效应量时配 95% CI。只给 p 值等于没给效应大小。",
          "source": "TOP / 统计报告规范", "auto": true },
        { "id": "GEN-07", "severity": "warning", "check": "forbid-pattern", "target": "fulltext",
          "args": { "pattern": "\\bp\\s*[<>=]\\s*0?\\.[0-9]+\\b(?![^.]{0,80}(CI|interval|effect))", "flags": "i" },
          "message": "存在只给 p 值、邻域内没有效应量或 CI 的表述",
          "fix": "把「p<0.05」升级为「效应量 X（95% CI a–b），p=…」。",
          "source": "统计报告规范", "auto": true },
        { "id": "GEN-08", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "Data availability|data are available|数据可用性|data deposited|accession", "flags": "i" },
          "message": "缺少数据可用性声明",
          "fix": "写清数据在哪（仓库 + 登记号 / 受控访问条件）。TOP 第 2 项的强制要求，也是多数刊的硬门禁。",
          "source": "TOP Guidelines item 2", "auto": true },
        { "id": "GEN-09", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "Code availability|code is available|github\\.com|zenodo\\.org|代码可用性", "flags": "i" },
          "message": "缺少代码可用性声明",
          "fix": "给仓库链接 + 版本 tag + 环境文件；不要只写「合理请求可提供」。",
          "source": "TOP Guidelines item 3", "auto": true },
        { "id": "GEN-10", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "competing interest|conflict of interest|利益冲突|Declaration of interests", "flags": "i" },
          "message": "缺少利益冲突声明",
          "fix": "即使没有也要显式写「The authors declare no competing interests」。缺这句会被编辑部退回补。",
          "source": "多数期刊投稿硬要求", "auto": true },
        { "id": "GEN-11", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "Author contributions|author contribution|作者贡献|CRediT", "flags": "i" },
          "message": "缺少作者贡献声明",
          "fix": "用 CRediT 分类逐人写。通讯作者之外的实质性贡献必须列全。",
          "source": "ICMJE / CRediT", "auto": true },
        { "id": "GEN-12", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "ethic|IRB|IACUC|informed consent|伦理|approval number", "flags": "i" },
          "message": "缺少伦理批准或知情同意说明",
          "fix": "写批准机构 + 批号；动物实验写 IACUC/伦理批号与遵循的指南。",
          "source": "ICMJE / ARRIVE", "auto": true },
        { "id": "GEN-13", "severity": "warning", "check": "figure-reference-coverage", "target": "fulltext",
          "args": { "declared": null },
          "message": "正文引用的图编号少于声明的图数（或反之）",
          "fix": "每张图都必须在正文被显式引用至少一次；没被引用的图要么删要么并。",
          "source": "写作常识 + 编辑核对表", "auto": true },
        { "id": "GEN-14", "severity": "warning", "check": "max-words", "target": "fulltext",
          "args": { "max": 8000 },
          "message": "正文超过 8000 词（多数顶刊上限在 3000–5000）",
          "fix": "先查目标刊 limits；超了就搬去补充材料，不要靠删逻辑连接词压字数。",
          "source": "各刊 author guidelines", "auto": true },
        { "id": "GEN-15", "severity": "warning", "check": "forbid-pattern", "target": "fulltext",
          "args": { "pattern": "\\b(clearly|obviously|it is well known that|as everyone knows)\\b", "flags": "i" },
          "message": "出现「clearly / obviously / well known」类断言替代论证",
          "fix": "删掉修饰词，补证据或补引用。编辑把这类词当作论证缺失的信号。",
          "source": "写作规范", "auto": true },
        { "id": "GEN-16", "severity": "warning", "check": "forbid-pattern", "target": "fulltext",
          "args": { "pattern": "\\b(p\\s*<\\s*0\\.05\\s*(and|,)\\s*(p\\s*<\\s*0\\.05|therefore))|\\bproves?\\b|\\bproof that\\b", "flags": "i" },
          "message": "把统计显著等同为「证明」",
          "fix": "改成「与……一致 / 支持……」，并给出替代解释如何处理。",
          "source": "统计解释规范", "auto": true },
        { "id": "GEN-17", "severity": "warning", "check": "limitations-present", "target": "discussion",
          "args": { "pattern": "limitation|caveat|局限|不足", "flags": "i" },
          "message": "讨论里没有明确的局限性段落",
          "fix": "写三条具体局限（设计、样本、测量），每条说明它影响哪个结论、不影响哪个结论。",
          "source": "审稿人高频要求", "auto": true },
        { "id": "GEN-18", "severity": "warning", "check": "chunk-coverage", "target": "fulltext",
          "args": { "required": ["method", "result", "discussion"] },
          "message": "章节结构不完整（缺方法/结果/讨论）",
          "fix": "补齐 IMRaD。若目标刊用合并式结构，也要有可识别的小标题。",
          "source": "IMRaD", "auto": true },
        { "id": "GEN-19", "severity": "blocking", "check": "orphan-claims", "target": "store",
          "args": {},
          "message": "存在没有任何证据挂接的断言",
          "fix": "每条结论要么挂文献证据（含页码/图号），要么挂自有实验编号。孤儿断言是审稿人最爱攻击的点。",
          "source": "证据链原则", "auto": true },
        { "id": "GEN-20", "severity": "blocking", "check": "contradicted-claims", "target": "store",
          "args": {},
          "message": "存在被自己的证据反驳却仍在正文中当作结论的断言",
          "fix": "要么改结论表述，要么在讨论里明确处理这条反证。",
          "source": "证据链原则", "auto": true },
        { "id": "GEN-21", "severity": "warning", "check": "manual", "target": "abstract",
          "args": { "prompt": "摘要第二句是否明确写出了「空白」：别人做到了哪一步、缺的是什么？" },
          "message": "需要人工确认：摘要是否写清研究空白",
          "fix": "按 5 句模板重写：背景 → 空白 → 做法 → 关键结果 → 意义。",
          "source": "Mensh & Kording 2017", "auto": false },
        { "id": "GEN-22", "severity": "warning", "check": "manual", "target": "fulltext",
          "args": { "prompt": "Figure 1 能否单独看懂并传达本文的核心信息？" },
          "message": "需要人工确认：Figure 1 是否承载核心信息",
          "fix": "figure-first：先定 Figure 1 的一句话信息，再让正文围绕它组织。",
          "source": "figure-first 原则", "auto": false }
      ]
    },
    "consort": {
      "label": "CONSORT（随机对照试验）",
      "rules": [
        { "id": "CON-01", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "NCT\\d{8}|ISRCTN\\d+|ChiCTR|ACTRN|EudraCT|registered (at|with)|trial registration", "flags": "i" },
          "message": "缺临床试验注册号",
          "fix": "给出注册平台 + 号，并注明注册时间早于首例入组。",
          "source": "CONSORT item 2b, ICMJE", "auto": true },
        { "id": "CON-02", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "random(ly|ised|ized|isation|ization)|allocation", "flags": "i" },
          "message": "没有说明随机化方法与分配隐藏",
          "fix": "写清序列生成方式（如 computer-generated block randomization）与分配隐藏机制（如 central web-based）。",
          "source": "CONSORT item 8–9", "auto": true },
        { "id": "CON-03", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "blind(ed|ing)|mask(ed|ing)|open-label", "flags": "i" },
          "message": "没有说明盲法（或明确声明为开放标签）",
          "fix": "写清谁被设盲、如何设盲、破盲条件。开放标签要说明为何不可行。",
          "source": "CONSORT item 11", "auto": true },
        { "id": "CON-04", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "primary (outcome|endpoint)|主要结局|primary endpoint", "flags": "i" },
          "message": "没有明确的主要结局",
          "fix": "点名主要结局、测量时点、以及是否与注册一致。多个主要结局要有校正策略。",
          "source": "CONSORT item 6a", "auto": true },
        { "id": "CON-05", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "CONSORT flow|flow diagram|screened|excluded|lost to follow|withdrew", "flags": "i" },
          "message": "缺少受试者流程（筛选/排除/失访）",
          "fix": "给 CONSORT 流程图或等价叙述：筛选数、随机数、各组完成数、失访原因。",
          "source": "CONSORT item 13", "auto": true },
        { "id": "CON-06", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "power|sample size calculation|检验效能|样本量估算", "flags": "i" },
          "message": "缺少样本量估算依据",
          "fix": "给预期效应量、α、power、脱落率，以及据此算出的 n。",
          "source": "CONSORT item 7a", "auto": true },
        { "id": "CON-07", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "intention.to.treat|per.protocol|ITT", "flags": "i" },
          "message": "未说明分析集（ITT / PP）",
          "fix": "主分析用 ITT，并说明缺失数据的处理方式（多重插补等）。",
          "source": "CONSORT item 16", "auto": true },
        { "id": "CON-08", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "adverse event|harm|side effect|不良事件", "flags": "i" },
          "message": "没有报告不良事件",
          "fix": "按组报告 AE/SAE 数量与类型；即使为零也要写明。",
          "source": "CONSORT item 19", "auto": true }
      ]
    },
    "prisma": {
      "label": "PRISMA（系统综述 / meta 分析）",
      "rules": [
        { "id": "PRI-01", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "PROSPERO|registered protocol|注册号|CRD\\d+", "flags": "i" },
          "message": "缺少综述方案预注册",
          "fix": "给 PROSPERO 号或 OSF 注册链接；若为回顾性注册，明确说明。",
          "source": "PRISMA 2020 item 24a", "auto": true },
        { "id": "PRI-02", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "PubMed|Embase|Web of Science|Scopus|Cochrane|CNKI|万方", "flags": "i" },
          "message": "没有列出检索的数据库",
          "fix": "列出全部数据库、检索日期、以及每个库的完整检索式（放补充材料）。",
          "source": "PRISMA 2020 item 7", "auto": true },
        { "id": "PRI-03", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "PRISMA|flow diagram|records identified|records screened", "flags": "i" },
          "message": "缺少筛选流程（PRISMA 流程图或等价叙述）",
          "fix": "给识别数、去重后数、全文评估数、最终纳入数及排除原因。",
          "source": "PRISMA 2020 item 16", "auto": true },
        { "id": "PRI-04", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "risk of bias|RoB|Newcastle|MINORS|quality assessment|偏倚风险", "flags": "i" },
          "message": "缺少偏倚风险评估方法与结果",
          "fix": "给工具（RoB 2 / ROBINS-I / NOS）、双人独立评估、分歧解决方式。",
          "source": "PRISMA 2020 item 11/18", "auto": true },
        { "id": "PRI-05", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "I²|I2|heterogeneity|异质性|tau", "flags": "i" },
          "message": "缺少异质性量化",
          "fix": "给 I²、τ²、以及选择固定/随机效应模型的理由。",
          "source": "PRISMA / Cochrane Handbook", "auto": true },
        { "id": "PRI-06", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "publication bias|funnel plot|Egger|trim.and.fill", "flags": "i" },
          "message": "缺少发表偏倚评估",
          "fix": "给漏斗图或 Egger 检验；纳入研究 <10 篇时说明为何不做。",
          "source": "PRISMA 2020 item 15", "auto": true }
      ]
    },
    "strobe": {
      "label": "STROBE（观察性研究）",
      "rules": [
        { "id": "STR-01", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "cohort|cross.sectional|case.control|队列|横断面|病例对照", "flags": "i" },
          "message": "没有明确研究设计类型",
          "fix": "标题或摘要里点名设计（队列/病例对照/横断面），并说明是前瞻还是回顾。",
          "source": "STROBE item 1", "auto": true },
        { "id": "STR-02", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "eligibility|inclusion criteria|exclusion criteria|纳入标准|排除标准", "flags": "i" },
          "message": "缺少纳入/排除标准",
          "fix": "写清人群来源、时间窗、纳排标准，以及选择偏倚的可能来源。",
          "source": "STROBE item 5–6", "auto": true },
        { "id": "STR-03", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "confound|adjust|multivariable|propensity|校正|混杂", "flags": "i" },
          "message": "没有处理混杂因素",
          "fix": "列出候选混杂、测量方式、校正模型，以及未测量混杂的敏感性分析。",
          "source": "STROBE item 14", "auto": true },
        { "id": "STR-04", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "missing data|loss to follow|缺失|失访", "flags": "i" },
          "message": "未报告缺失数据量与处理方式",
          "fix": "给缺失比例、缺失机制假设、以及插补或完整病例分析的对比。",
          "source": "STROBE item 12c", "auto": true },
        { "id": "STR-05", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "sensitivity analysis|subgroup|敏感性分析|亚组", "flags": "i" },
          "message": "缺少敏感性或亚组分析",
          "fix": "至少给一项敏感性分析；亚组要声明是预设还是事后。",
          "source": "STROBE item 17", "auto": true }
      ]
    },
    "arrive": {
      "label": "ARRIVE（动物研究）",
      "rules": [
        { "id": "ARR-01", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "species|strain|C57|Sprague|Wistar|品系|物种", "flags": "i" },
          "message": "缺少物种/品系信息",
          "fix": "给物种、品系、性别、年龄/体重、来源与许可证号。",
          "source": "ARRIVE 2.0 item 1–2", "auto": true },
        { "id": "ARR-02", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "housing|husbandry|light.cycle|饲育|饲养|12.h|temperature", "flags": "i" },
          "message": "缺少饲养与饲养环境条件",
          "fix": "写笼养密度、光周期、温湿度、食水、适应期。这些直接影响可重复性。",
          "source": "ARRIVE 2.0 item 3", "auto": true },
        { "id": "ARR-03", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "humane endpoint|euthan|sacrific|人道终点|安乐死", "flags": "i" },
          "message": "缺少人道终点或处死方法",
          "fix": "写预设的人道终点标准与处死方式；说明谁在什么条件下执行。",
          "source": "ARRIVE 2.0 item 4", "auto": true },
        { "id": "ARR-04", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "random(ly|ised|ized) (assign|allocat)|randomisation", "flags": "i" },
          "message": "未说明动物随机分组方法",
          "fix": "写清随机化单位（笼/个体）与实现方式；笼效应要考虑进去。",
          "source": "ARRIVE 2.0 item 8", "auto": true },
        { "id": "ARR-05", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "blinded|blinding|outcome assessment", "flags": "i" },
          "message": "未说明结果评估是否设盲",
          "fix": "至少对行为学/组织学评分设盲；说明谁持有分组表。",
          "source": "ARRIVE 2.0 item 9", "auto": true }
      ]
    },
    "tripod": {
      "label": "TRIPOD（预测模型）",
      "rules": [
        { "id": "TRI-01", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "predictor|feature|covariate|预测因子|变量", "flags": "i" },
          "message": "缺少预测因子定义",
          "fix": "逐条给出预测因子定义、测量时点、单位与预处理。",
          "source": "TRIPOD item 3a", "auto": true },
        { "id": "TRI-02", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "AUC|C.statistic|calibration|Brier|discrimination|区分度|校准", "flags": "i" },
          "message": "缺少区分度或校准评价",
          "fix": "同时给区分度（AUC/C-index）与校准（校准曲线/斜率/Brier）。只有 AUC 不够。",
          "source": "TRIPOD item 10b", "auto": true },
        { "id": "TRI-03", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "internal validation|external validation|cross.validat|bootstrap|验证", "flags": "i" },
          "message": "缺少验证（内部或外部）",
          "fix": "给内部验证（bootstrap/交叉验证）或外部队列验证；两者都要报性能变化。",
          "source": "TRIPOD item 10", "auto": true },
        { "id": "TRI-04", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "events per variable|EPV|overfit|过拟合|样本量", "flags": "i" },
          "message": "未讨论过拟合风险或 EPV",
          "fix": "给每变量事件数（EPV）或按 Riley 等提出的最小样本量计算。",
          "source": "TRIPOD / Riley 2019", "auto": true }
      ]
    },
    "open-science": {
      "label": "开放科学（TOP Guidelines 8 项）",
      "rules": [
        { "id": "TOP-01", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "cite(s|d)? (the )?(data|code)|data citation|引用.*数据", "flags": "i" },
          "message": "TOP 第 1 项：未体现数据/代码引用",
          "fix": "把数据集与代码包当作正式引用条目列出（含 DOI）。",
          "source": "TOP Guidelines item 1", "auto": true },
        { "id": "TOP-02", "severity": "blocking", "check": "require-pattern", "target": "any",
          "args": { "pattern": "pre.?regist|OSF|AsPredicted|预注册", "flags": "i" },
          "message": "TOP 第 6 项：未声明预注册状态",
          "fix": "有注册就给链接；没有就明确写「本研究未预注册」，不要沉默。",
          "source": "TOP Guidelines item 6", "auto": true },
        { "id": "TOP-03", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "analysis plan|统计分析计划|SAP|deviations from", "flags": "i" },
          "message": "TOP 第 7 项：未说明分析计划或与计划的偏离",
          "fix": "列出预设分析；把事后分析显式标为 exploratory。",
          "source": "TOP Guidelines item 7", "auto": true },
        { "id": "TOP-04", "severity": "warning", "check": "require-pattern", "target": "any",
          "args": { "pattern": "reproduc|replicat|复现|环境|container|docker|version", "flags": "i" },
          "message": "TOP 第 8 项：未体现可复现性信息",
          "fix": "给软件版本、随机种子、容器镜像或环境锁文件。",
          "source": "TOP Guidelines item 8", "auto": true }
      ]
    }
  }
}
