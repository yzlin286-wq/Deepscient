{
  "$meta": {
    "schema": "tools-registry/1",
    "note": "学科工具注册表。science_discipline_profile 按 domain/kind 过滤返回；science_study_coach 在「这一步该用什么软件」时引用。install 与 minimalScript 均可直接复制执行。offline=false 表示核心功能依赖联网。",
    "updatedAt": "2026-10-21",
    "selection": "优先选免费的、能脚本化的、结果可导出的。GUI 专用工具（SPSS、Origin）只在导师要求或社区惯例必要时推荐。"
  },
  "tools": [
    { "id": "python", "label": "Python", "kind": "language", "domain": ["*"], "install": "https://www.python.org 或 miniconda", "minimalScript": "python -c \"import numpy, scipy, pandas, matplotlib; print(numpy.__version__)\"", "alt": ["R"], "offline": true, "license": "PSF-2.0", "note": "本应用的所有统计与图表执行器都跑在 Python 上，已装 numpy/scipy/pandas/matplotlib/statsmodels/sklearn" },
    { "id": "r", "label": "R", "kind": "language", "domain": ["biomed", "psychology", "economics", "agri-food", "earth-env", "social-humanities"], "install": "https://cran.r-project.org", "minimalScript": "Rscript -e 'library(stats); print(t.test(rnorm(30), rnorm(30)))'", "alt": ["Python"], "offline": true, "license": "GPL-2", "note": "生医/心理/经济/生态的社区标准；本应用不执行 R，只提供可复制片段" },
    { "id": "rstudio", "label": "RStudio", "kind": "ide", "domain": ["*"], "install": "https://posit.co/download/rstudio-desktop", "minimalScript": "（图形界面）", "alt": ["VS Code + R extension"], "offline": true, "license": "AGPL-3" },

    { "id": "scipy-stats", "label": "SciPy stats", "kind": "stats", "domain": ["*"], "install": "pip install scipy", "minimalScript": "from scipy import stats; print(stats.ttest_ind(a, b, equal_var=False))", "alt": ["statsmodels", "R"], "offline": true, "license": "BSD-3-Clause" },
    { "id": "statsmodels", "label": "statsmodels", "kind": "stats", "domain": ["*"], "install": "pip install statsmodels", "minimalScript": "import statsmodels.api as sm; print(sm.OLS(y, sm.add_constant(X)).fit().summary())", "alt": ["R", "linearmodels"], "offline": true, "license": "BSD-3-Clause", "note": "本应用的检验执行、功效计算、混合模型、多重比较都走它" },
    { "id": "pingouin", "label": "pingouin", "kind": "stats", "domain": ["psychology", "biomed"], "install": "pip install pingouin", "minimalScript": "import pingouin as pg; pg.ttest(a, b, correction=True)", "alt": ["statsmodels", "JASP"], "offline": true, "license": "GPL-3", "note": "心理学常用的便捷封装（偏 η²、球形性、事后检验一次给全）" },
    { "id": "lifelines", "label": "lifelines", "kind": "stats", "domain": ["biomed"], "install": "pip install lifelines", "minimalScript": "from lifelines import CoxPHFitter; CoxPHFitter().fit(df, 'time', 'event')", "alt": ["R survival"], "offline": true, "license": "MIT", "note": "本机未装；缺它时用内置 KM+log-rank 实现兜底（status: fallback）" },
    { "id": "pymc", "label": "PyMC", "kind": "stats", "domain": ["*"], "install": "pip install pymc", "minimalScript": "import pymc as pm; print(pm.draw(1000, random_seed=1))", "alt": ["Stan", "R brms"], "offline": true, "license": "Apache-2.0", "note": "本机未装；缺它时用 JZS Bayes 因子解析式兜底" },
    { "id": "spss", "label": "SPSS", "kind": "stats", "domain": ["psychology", "biomed", "social-humanities", "agri-food"], "install": "商业授权（校内常见）", "minimalScript": "（图形界面；T-TEST GROUPS=g(1 2) /VARIABLES=y.）", "alt": ["jamovi", "JASP", "R"], "offline": true, "license": "commercial", "note": "导师要求时用；建议同时用 R/Python 复算一遍" },
    { "id": "stata", "label": "Stata", "kind": "stats", "domain": ["economics", "biomed"], "install": "商业授权", "minimalScript": "reghdfe y treated, absorb(id year) vce(cluster id)", "alt": ["R fixest", "Python linearmodels"], "offline": true, "license": "commercial" },
    { "id": "jamovi", "label": "jamovi", "kind": "stats", "domain": ["psychology", "*"], "install": "https://www.jamovi.org", "minimalScript": "（图形界面，免费，内置混合模型与事后检验）", "alt": ["JASP", "R"], "offline": true, "license": "AGPL-3", "note": "不想写代码时的最佳选择，输出可直接改成 APA 表" },
    { "id": "jasp", "label": "JASP", "kind": "stats", "domain": ["psychology", "*"], "install": "https://jasp-stats.org", "minimalScript": "（图形界面，内置贝叶斯因子）", "alt": ["jamovi", "R BayesFactor"], "offline": true, "license": "GPL-3" },
    { "id": "matlab", "label": "MATLAB", "kind": "language", "domain": ["engineering", "physics", "neuroscience"], "install": "商业授权（校内常见）", "minimalScript": "t = ttest2(a, b)", "alt": ["Python numpy/scipy", "Octave"], "offline": true, "license": "commercial" },
    { "id": "linearmodels", "label": "Python linearmodels", "kind": "stats", "domain": ["economics"], "install": "pip install linearmodels", "minimalScript": "from linearmodels import PanelOLS; PanelOLS(y, X, entity_effects=True).fit(cov_type='clustered')", "alt": ["Stata reghdfe", "R fixest"], "offline": true, "license": "BSD-3-Clause" },

    { "id": "matplotlib", "label": "matplotlib", "kind": "figure", "domain": ["*"], "install": "pip install matplotlib", "minimalScript": "import matplotlib.pyplot as plt; plt.plot([1,2],[3,4]); plt.savefig('f.pdf')", "alt": ["R ggplot2"], "offline": true, "license": "PSF-based", "note": "本应用的图表执行器；默认出矢量 PDF（投稿要求）" },
    { "id": "seaborn", "label": "seaborn", "kind": "figure", "domain": ["*"], "install": "pip install seaborn", "minimalScript": "import seaborn as sns; sns.set_theme(style='ticks', palette='colorblind')", "alt": ["matplotlib"], "offline": true, "license": "BSD-3-Clause", "note": "colorblind 调色板是色盲安全的默认选择" },
    { "id": "ggplot2", "label": "R ggplot2", "kind": "figure", "domain": ["*"], "install": "install.packages('ggplot2')", "minimalScript": "library(ggplot2); ggplot(d, aes(x, y, colour=g)) + geom_point() + theme_classic()", "alt": ["matplotlib"], "offline": true, "license": "MIT" },
    { "id": "origin", "label": "Origin / OriginPro", "kind": "figure", "domain": ["chemistry", "materials", "physics", "engineering"], "install": "商业授权（校内常见）", "minimalScript": "（图形界面）", "alt": ["matplotlib", "R"], "offline": true, "license": "commercial", "note": "化学材料圈的惯例；记得导出 600dpi TIFF 或矢量 EPS" },
    { "id": "illustrator", "label": "Adobe Illustrator", "kind": "figure", "domain": ["*"], "install": "商业授权", "minimalScript": "（图形界面；用于拼多面板图与统一字号）", "alt": ["Inkscape（免费）"], "offline": true, "license": "commercial", "note": "拼图时字号与线宽必须统一，且最终尺寸按期刊栏宽" },
    { "id": "inkscape", "label": "Inkscape", "kind": "figure", "domain": ["*"], "install": "https://inkscape.org", "minimalScript": "（图形界面，免费矢量编辑）", "alt": ["Illustrator"], "offline": true, "license": "GPL-3" },

